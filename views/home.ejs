<%- include("partials/header") %>

<div class="loader" aria-hidden="true">
	<span class="loader-count">0</span>
</div>

<section class="build" id="build">
	<div class="build-stage">
		<div class="build-glow" aria-hidden="true"></div>
		<div class="build-words" aria-hidden="true">
			<div class="build-word" data-dir="-1">Byte the burger Byte the burger</div>
			<div class="build-word build-word-outline" data-dir="1">Six layers six layers six layers</div>
		</div>

		<canvas class="build-canvas" aria-label="A burger that builds itself, layer by layer, as you scroll"></canvas>
		<div class="build-tags" aria-hidden="true"></div>

		<div class="build-intro">
			<p class="eyebrow">Smash burgers, free delivery</p>
			<h1 class="display">
				<span class="line"><span>Six layers.</span></span>
				<span class="line"><span><em>One</em> bite.</span></span>
			</h1>
			<p class="lede">Scroll to build it. Every layer is made fresh when you order.</p>
		</div>

		<div class="build-outro">
			<p class="eyebrow">The Byte, $9.50</p>
			<h2 class="display">Ready in <em>8 minutes.</em></h2>
			<div class="actions">
				<a class="btn" href="#menu">Order delivery</a>
				<a class="btn btn-ghost" href="#menu">See the menu</a>
			</div>
		</div>

		<div class="build-hud">
			<div class="hud-count"><span class="hud-now">01</span><span class="hud-total">/ 06</span></div>
			<div class="hud-name">Toasted bottom bun</div>
			<div class="hud-bar"><span></span></div>
		</div>

		<div class="scroll-cue" aria-hidden="true"><span></span>Scroll</div>
	</div>
</section>

<section class="ticker" aria-hidden="true">
	<div class="ticker-track">
		<span>Free delivery</span><span>Grilled to order</span><span>Cash on delivery</span><span>Pickup in 8 minutes</span>
		<span>Free delivery</span><span>Grilled to order</span><span>Cash on delivery</span><span>Pickup in 8 minutes</span>
	</div>
</section>

<section class="menu" id="menu">
	<div class="section-head">
		<p class="eyebrow">Menu</p>
		<h2 class="display reveal-words">Short menu. <em>Done well.</em></h2>
	</div>
	<div class="menu-grid">
		<% menu.forEach((item, i) => { %>
		<article class="menu-card" data-id="<%= item.id %>" data-name="<%= item.name %>" data-price="<%= item.priceCents %>">
			<div class="menu-card-top">
				<span class="menu-num"><%= String(i + 1).padStart(2, "0") %></span>
				<span class="menu-tag"><%= item.tag %></span>
			</div>
			<h3><%= item.name %></h3>
			<p><%= item.description %></p>
			<div class="menu-card-bottom">
				<span class="menu-price">$<%= item.price %></span>
				<button class="menu-add" type="button" aria-label="Add <%= item.name %> to order">+</button>
			</div>
		</article>
		<% }) %>
	</div>
</section>

<section class="how" id="how">
	<div class="section-head">
		<p class="eyebrow">How it works</p>
		<h2 class="display reveal-words">From order to <em>your hands.</em></h2>
	</div>
	<ol class="how-steps">
		<li class="how-step">
			<span class="how-num">01</span>
			<h3>Order</h3>
			<p>Order here for free delivery, for pickup, or from your table with the QR code.</p>
		</li>
		<li class="how-step">
			<span class="how-num">02</span>
			<h3>We grill it</h3>
			<p>Your order goes straight to the kitchen screen. Nothing is cooked before you order.</p>
		</li>
		<li class="how-step">
			<span class="how-num">03</span>
			<h3>Get it</h3>
			<p>Follow your order live. Pay the driver in cash, or pay at the counter.</p>
		</li>
	</ol>
	<div class="how-line" aria-hidden="true"><span></span></div>
</section>

<section class="order" id="order">
	<p class="eyebrow">Hungry yet?</p>
	<h2 class="order-title display"><span data-speed="-0.4">Order</span> <em data-speed="0.4">now.</em></h2>
	<a class="btn btn-large" href="#menu">Start your order</a>
</section>

<%- include("partials/cart") %>
<%- include("partials/footer") %>
